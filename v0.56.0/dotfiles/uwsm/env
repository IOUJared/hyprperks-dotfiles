export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=auto
export GDK_BACKEND="wayland,x11,*"
export QT_QPA_PLATFORM="wayland;xcb"
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export QT_QPA_PLATFORMTHEME=hyprqt6engine
# Use the style-only fix only with the versions it was built/tested against.
# After an upgrade, use the system plugin until the fix is rebuilt/revalidated.
if [ "$(pacman -Q hyprqt6engine 2>/dev/null)" = "hyprqt6engine 0.1.0-4" ] &&
   [ "$(pkg-config --modversion Qt6Core 2>/dev/null)" = "6.11.2" ]; then
    export QT_PLUGIN_PATH="$HOME/.local/lib/qt6/plugins"
else
    unset QT_PLUGIN_PATH
fi
export HYPRSHOT_DIR="$HOME/Pictures/Screenshots"
export HLDE_HYPRLOCK_CUSTOM=1
export HLDE_HYPRIDLE_CUSTOM=1
export SDL_VIDEODRIVER=wayland,x11
export _JAVA_AWT_WM_NONREPARENTING=1
export XCURSOR_SIZE=20
export XCURSOR_THEME=Bibata-Modern-Classic
export HYPRCURSOR_THEME=Bibata-Modern-Classic-Hyprcursor
export HYPRCURSOR_SIZE=20
export GDK_SCALE=1
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_DIRS="$HOME/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:/usr/local/share:/usr/share"
export GOPATH="$XDG_DATA_HOME/go"
export BUN_INSTALL="$HOME/.bun"
export PATH="$PATH:$XDG_DATA_HOME/cargo/bin:$GOPATH/bin:$BUN_INSTALL/bin"
# Stable launcher for the installed Playwright Chromium builds.
export CHROME_EXECUTABLE="$HOME/.local/bin/chromium-local"
export RUSTUP_HOME="$XDG_DATA_HOME/rustup"
export CARGO_HOME="$XDG_DATA_HOME/cargo"
export GNUPGHOME="$XDG_DATA_HOME/gnupg"
export GRADLE_USER_HOME="$XDG_DATA_HOME/gradle"
export GTK2_RC_FILES="$XDG_CONFIG_HOME/gtk-2.0/gtkrc"
export PARALLEL_HOME="$XDG_CONFIG_HOME/parallel"
export WINEPREFIX="$XDG_DATA_HOME/wine"
export TEXMFVAR="$XDG_CACHE_HOME/texlive/texmf-var"
export ZSH="$XDG_DATA_HOME/oh-my-zsh"
